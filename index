# =======================
# SERVER
# =======================

server <- function(input, output, session) {
  
  output$initial_fail_rate <- renderText({
    paste0(round(initial_failure_rate * 100, 1), "%")
  })
  
  optimization_results <- reactive({
    req(input$target_fail_rate)
    optimize_improvements(input$target_fail_rate, component_summary)
  })
  
  output$total_investment <- renderText({
    results <- optimization_results()
    dollar(results$total_cost)
  })
  
  # Cost per failure
  cost_per_failure_text <- reactive({
    expected_cost_per_failure <- sum(event_costs$Probability * event_costs$Cost_per_Event)
    dollar(expected_cost_per_failure)
  })
  
  output$cost_per_failure_home <- renderText({ cost_per_failure_text() })
  output$cost_per_failure_discussion <- renderText({ cost_per_failure_text() })
  
  # =======================
  # PLOTS
  # =======================
  
  # Impact Analysis Plot (Home)
  output$impact_analysis_plot <- renderPlotly({
    results <- optimization_results()
    
    rpn_comparison <- data.frame(
      Component = rep(results$new_rpn$Component_Short, 2),
      Category = rep(c("Before", "After"), each = nrow(results$new_rpn)),
      RPN = c(results$new_rpn$Total_RPN, results$new_rpn$New_RPN)
    )
    
    p <- ggplot(rpn_comparison, aes(x = reorder(Component, -RPN), y = RPN, fill = Category)) +
      geom_col(position = "dodge", alpha = 0.85, width = 0.7) +
      scale_fill_manual(values = c("Before" = color_secondary, "After" = color_accent)) +
      labs(x = "", y = "Risk Priority Number (RPN)") +
      theme_minimal(base_size = 13) +
      theme(
        legend.position = "top",
        legend.title = element_blank(),
        axis.text = element_text(size = 12),
        axis.title = element_text(size = 13, face = "bold"),
        panel.grid.major.x = element_blank()
      ) +
      coord_flip()
    
    ggplotly(p, tooltip = c("x", "y", "fill")) %>%
      layout(legend = list(orientation = "h", x = 0.3, y = 1.1))
  })
  
  # CDF Plot
  output$cdf_time_plot_results <- renderPlot({
    results <- optimization_results()
    
    time_seq <- seq(0, 5, length.out = 200)
    lambda_before <- initial_failure_rate
    lambda_after  <- results$new_failure_rate
    
    N <- 200
    B <- 1000
    
    boot_cdfs_before <- matrix(0, nrow = B, ncol = length(time_seq))
    boot_cdfs_after  <- matrix(0, nrow = B, ncol = length(time_seq))
    
    for (b in 1:B) {
      simulated_before <- rexp(N, rate = lambda_before)
      simulated_after  <- rexp(N, rate = lambda_after)
      
      lambda_before_hat <- 1 / mean(simulated_before)
      lambda_after_hat  <- 1 / mean(simulated_after)
      
      boot_cdfs_before[b, ] <- 1 - exp(-lambda_before_hat * time_seq)
      boot_cdfs_after[b, ]  <- 1 - exp(-lambda_after_hat  * time_seq)
    }
    
    cdf_before <- 1 - exp(-lambda_before * time_seq)
    cdf_after  <- 1 - exp(-lambda_after  * time_seq)
    
    ci_before_lower <- apply(boot_cdfs_before, 2, quantile, probs = 0.025)
    ci_before_upper <- apply(boot_cdfs_before, 2, quantile, probs = 0.975)
    
    ci_after_lower  <- apply(boot_cdfs_after,  2, quantile, probs = 0.025)
    ci_after_upper  <- apply(boot_cdfs_after,  2, quantile, probs = 0.975)
    
    # Prepare data for ribbons
    ribbon_data <- data.frame(
      Time = rep(time_seq, 2),
      Lower = c(ci_before_lower, ci_after_lower),
      Upper = c(ci_before_upper, ci_after_upper),
      Scenario = rep(c("Before Investment", "After Investment"), each = length(time_seq))
    )
    
    main_data <- data.frame(
      Time = rep(time_seq, 2),
      CDF = c(cdf_before, cdf_after),
      Scenario = rep(c("Before Investment", "After Investment"), each = length(time_seq))
    )
    
    ggplot() +
      geom_ribbon(data = ribbon_data,
                  aes(x = Time, ymin = Lower, ymax = Upper, fill = Scenario),
                  alpha = 0.25) +
      geom_line(data = main_data,
                aes(x = Time, y = CDF, color = Scenario),
                linewidth = 1.5) +
      scale_color_manual(values = c("Before Investment" = color_secondary,
                                    "After Investment" = color_accent)) +
      scale_fill_manual(values = c("Before Investment" = color_secondary,
                                   "After Investment" = color_accent)) +
      labs(x = "Time (Years)", y = "Cumulative Probability of Failure") +
      scale_y_continuous(labels = percent_format(), limits = c(0, 1)) +
      scale_x_continuous(breaks = 0:5) +
      theme_minimal(base_size = 14) +
      theme(
        legend.position = "top",
        legend.title = element_blank(),
        axis.text = element_text(size = 12),
        axis.title = element_text(size = 13, face = "bold")
      )
  })
  
  # Component Failure Rates
  output$component_failure_combined_results <- renderPlot({
    results <- optimization_results()
    
    component_before <- component_summary %>%
      mutate(
        Failure_Rate = (Total_RPN / sum(Total_RPN)) * initial_failure_rate,
        SE = sqrt(Failure_Rate * (1 - Failure_Rate) / 100000),
        Lower_CI = pmax(0, Failure_Rate - 1.96 * SE),
        Upper_CI = Failure_Rate + 1.96 * SE,
        Scenario = "Before Investment"
      ) %>%
      select(Component = Component_Short, Failure_Rate, Lower_CI, Upper_CI, Scenario)
    
    component_after <- results$new_rpn %>%
      mutate(
        Failure_Rate = (New_RPN / sum(New_RPN)) * results$new_failure_rate,
        SE = sqrt(Failure_Rate * (1 - Failure_Rate) / 100000),
        Lower_CI = pmax(0, Failure_Rate - 1.96 * SE),
        Upper_CI = Failure_Rate + 1.96 * SE,
        Scenario = "After Investment"
      ) %>%
      select(Component = Component_Short, Failure_Rate, Lower_CI, Upper_CI, Scenario)
    
    combined_data <- rbind(component_before, component_after)
    
    # Get ordering from "Before Investment" rates
    component_order <- component_before %>%
      arrange(desc(Failure_Rate)) %>%
      pull(Component)
    
    combined_data$Component <- factor(combined_data$Component, levels = component_order)
    
    ggplot(combined_data, aes(x = Component, y = Failure_Rate, fill = Scenario)) +
      geom_col(position = position_dodge(width = 0.8), alpha = 0.85, width = 0.7) +
      geom_errorbar(aes(ymin = Lower_CI, ymax = Upper_CI), 
                    position = position_dodge(width = 0.8), 
                    width = 0.25, linewidth = 0.8, color = "black", alpha = 0.7) +
      scale_fill_manual(values = c("Before Investment" = color_secondary, 
                                   "After Investment" = color_accent)) +
      coord_flip() +
      scale_y_continuous(labels = percent_format(accuracy = 0.01)) +
      labs(x = "", y = "Component Failure Rate") +
      theme_minimal(base_size = 14) +
      theme(
        legend.position = "top",
        legend.title = element_blank(),
        axis.text = element_text(size = 12),
        axis.text.y = element_text(size = 11),
        axis.title = element_text(size = 13, face = "bold"),
        panel.grid.major.y = element_blank()
      )
  })
  
  # Investment vs Impact Plot
  output$investment_impact_plot <- renderPlot({
    results <- optimization_results()
    
    if (nrow(results$improvements) == 0) {
      plot.new()
      text(0.5, 0.5, "No improvements needed", cex = 1.2)
    } else {
      investment_impact <- results$improvements %>%
        group_by(Component) %>%
        summarise(
          Total_Investment = sum(Cost),
          .groups = 'drop'
        ) %>%
        left_join(
          results$new_rpn %>% select(Component_Short, RPN_Reduction),
          by = c("Component" = "Component_Short")
        )
      
      # Create short labels for better display
      investment_impact <- investment_impact %>%
        mutate(Short_Label = case_when(
          grepl("Infusion", Component) ~ "Infusion Set",
          grepl("Software", Component) ~ "Software",
          grepl("Sensors", Component) ~ "Sensors",
          grepl("Pump motor", Component) ~ "Pump Motor",
          grepl("Insulin", Component) ~ "Insulin Reservoir",
          grepl("Battery", Component) ~ "Battery",
          grepl("User", Component) ~ "User Interface",
          grepl("Circuit", Component) ~ "Circuit Board",
          TRUE ~ Component
        ))
      
      # Create the plot
      ggplot(investment_impact, aes(x = RPN_Reduction, y = Total_Investment)) +
        # Add confidence band for linear model
        geom_smooth(method = "lm", se = TRUE, alpha = 0.15, 
                    color = color_primary, fill = color_primary, linewidth = 1) +
        # Add points
        geom_point(aes(color = Short_Label), size = 6, alpha = 0.85) +
        # Add text labels
        geom_text(aes(label = Short_Label, color = Short_Label), 
                  vjust = -1.2, size = 3.5, fontface = "bold", show.legend = FALSE) +
        scale_y_continuous(labels = dollar_format(scale = 1e-3, suffix = "K"),
                           limits = c(0, NA),
                           expand = expansion(mult = c(0.05, 0.15))) +
        scale_x_continuous(limits = c(0, NA),
                           expand = expansion(mult = c(0.05, 0.15))) +
        scale_color_manual(values = c(
          "Infusion Set" = "#FF8C42",
          "Software" = "#DC143C", 
          "Sensors" = "#228B22",
          "Pump Motor" = "#FF6B6B",
          "Insulin Reservoir" = "#00CED1",
          "Battery" = "#9370DB",
          "User Interface" = "#FFD700",
          "Circuit Board" = "#4169E1"
        )) +
        labs(
          x = "RPN Reduction", 
          y = "Investment Required ($)"
        ) +
        theme_minimal(base_size = 14) +
        theme(
          legend.position = "none",
          axis.text = element_text(size = 12),
          axis.title = element_text(size = 13, face = "bold"),
          panel.grid.minor = element_blank(),
          plot.margin = margin(10, 15, 10, 10)
        )
    }
  })
  
  # RPN Reduction Plot
  output$rpn_reduction_plot_results <- renderPlot({
    results <- optimization_results()
    
    rpn_comparison <- data.frame(
      Component = rep(results$new_rpn$Component_Short, 2),
      Category = rep(c("Before", "After"), each = nrow(results$new_rpn)),
      RPN = c(results$new_rpn$Total_RPN, results$new_rpn$New_RPN)
    )
    
    ggplot(rpn_comparison, aes(x = reorder(Component, -RPN), y = RPN, fill = Category)) +
      geom_col(position = "dodge", alpha = 0.85, width = 0.7) +
      scale_fill_manual(values = c("Before" = color_secondary, "After" = color_accent)) +
      coord_flip() +
      labs(x = "", y = "Risk Priority Number (RPN)") +
      theme_minimal(base_size = 14) +
      theme(
        legend.position = "top",
        legend.title = element_blank(),
        axis.text = element_text(size = 12),
        axis.title = element_text(size = 13, face = "bold"),
        panel.grid.major.y = element_blank()
      )
  })
  
  # Distribution Plot
  output$distribution_plot <- renderPlot({
    results <- optimization_results()
    
    # Use 0-15 years to show full distribution
    x_seq <- seq(0, 15, length.out = 300)
    
    density_before <- dexp(x_seq, rate = initial_failure_rate)
    density_after <- dexp(x_seq, rate = results$new_failure_rate)
    
    plot_data <- data.frame(
      Time = rep(x_seq, 2),
      Density = c(density_before, density_after),
      Scenario = rep(c("Before Investment", "After Investment"), each = length(x_seq))
    )
    
    ggplot(plot_data, aes(x = Time, y = Density, fill = Scenario)) +
      geom_area(alpha = 0.6, position = "identity") +
      scale_fill_manual(values = c("Before Investment" = color_secondary,
                                   "After Investment" = color_accent)) +
      labs(x = "Time (Years)", y = "Probability Density") +
      scale_x_continuous(breaks = seq(0, 15, by = 3)) +
      theme_minimal(base_size = 14) +
      theme(
        legend.position = "top",
        legend.title = element_blank(),
        axis.text = element_text(size = 12),
        axis.title = element_text(size = 13, face = "bold")
      )
  })
  
  # =======================
  # TABLES
  # =======================
  
  # Financial Tables
  render_financial_table <- function() {
    results <- optimization_results()
    
    annual_failures_before <- 100000 * initial_failure_rate
    annual_failures_after <- 100000 * results$new_failure_rate
    expected_cost_per_failure <- sum(event_costs$Probability * event_costs$Cost_per_Event)
    
    cost_before <- annual_failures_before * expected_cost_per_failure
    cost_after <- annual_failures_after * expected_cost_per_failure
    annual_savings <- cost_before - cost_after
    
    data.frame(
      Metric = c("Total Investment", "Annual Savings"),
      Value = c(dollar(results$total_cost), dollar(annual_savings))
    )
  }
  
  output$financial_table_home <- renderTable({
    render_financial_table()
  }, striped = TRUE, hover = TRUE, bordered = TRUE, width = "100%", 
  spacing = "m", align = "lc")
  
  output$financial_table_discussion <- renderTable({
    render_financial_table()
  }, striped = TRUE, hover = TRUE, bordered = TRUE, width = "100%",
  spacing = "m", align = "lc")
  
  # Distribution Stats Table
  output$distribution_stats <- renderTable({
    results <- optimization_results()
    
    data.frame(
      Metric = c("Mean Time to Failure (Before)", 
                 "Mean Time to Failure (After)",
                 "Improvement"),
      Value = c(
        sprintf("%.2f years", 1/initial_failure_rate),
        sprintf("%.2f years", 1/results$new_failure_rate),
        sprintf("%.1f%%", ((1/results$new_failure_rate) - (1/initial_failure_rate)) / (1/initial_failure_rate) * 100)
      )
    )
  }, striped = TRUE, hover = TRUE, bordered = TRUE, width = "100%",
  spacing = "s", align = "lc")
  
  # Recommendations Tables
  output$recommendations_table_home <- DT::renderDataTable({
    results <- optimization_results()
    
    if (nrow(results$improvements) == 0) {
      data.frame(Message = "No improvements needed for target rate")
    } else {
      recommendations <- results$improvements %>%
        mutate(
          Change = paste0(Type, ": ", From, " -> ", To),
          Investment = dollar(Cost)
        ) %>%
        select(Component, Change, Investment)
      
      DT::datatable(recommendations,
                    options = list(
                      pageLength = 8,
                      dom = 't',
                      ordering = FALSE,
                      columnDefs = list(
                        list(className = 'dt-left', targets = 0:1),
                        list(className = 'dt-right', targets = 2)
                      )
                    ),
                    rownames = FALSE,
                    class = 'cell-border stripe compact',
                    style = 'bootstrap')
    }
  })
  
  output$recommendations_table_discussion <- DT::renderDataTable({
    results <- optimization_results()
    
    if (nrow(results$improvements) == 0) {
      data.frame(Message = "No improvements needed for target rate")
    } else {
      recommendations <- results$improvements %>%
        mutate(
          Change = paste0(Type, ": ", From, " -> ", To),
          Investment = dollar(Cost)
        ) %>%
        select(Component, Change, Investment)
      
      DT::datatable(recommendations,
                    options = list(
                      pageLength = 15,
                      dom = 't',
                      ordering = TRUE,
                      columnDefs = list(
                        list(className = 'dt-left', targets = 0:1),
                        list(className = 'dt-right', targets = 2)
                      )
                    ),
                    rownames = FALSE,
                    class = 'cell-border stripe compact',
                    style = 'bootstrap')
    }
  })
  
  # FMEA Detailed Table
  output$fmea_detailed_table_methods <- DT::renderDataTable({
    display_data <- fmea_data %>%
      select(Component, `Failure Mode` = Failure_Mode, S = Severity, 
             O = Occurrence, D = Detection, RPN)
    
    DT::datatable(display_data,
                  options = list(
                    pageLength = 20,
                    dom = 't',
                    ordering = TRUE,
                    columnDefs = list(
                      list(className = 'dt-center', targets = 2:5),
                      list(className = 'dt-left', targets = 0:1)
                    )
                  ),
                  rownames = FALSE,
                  class = 'cell-border stripe compact',
                  style = 'bootstrap')
  })
}

shinyApp(ui = ui, server = server)
