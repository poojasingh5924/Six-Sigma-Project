# =======================
# OPTIMIZATION FUNCTION
# =======================

optimize_improvements <- function(target_failure_rate, component_data) {
  
  current_failure_rate <- initial_failure_rate
  total_cost <- 0
  improvements <- data.frame(
    Component = character(),
    Type = character(),
    From = numeric(),
    To = numeric(),
    Cost = numeric(),
    stringsAsFactors = FALSE
  )
  
  # Calculate required reduction
  required_reduction <- (initial_failure_rate - target_failure_rate) / initial_failure_rate
  
  if (required_reduction <= 0) {
    new_rpn_data <- component_data %>%
      mutate(New_RPN = Total_RPN, RPN_Reduction = 0)
    
    return(list(
      improvements = improvements,
      total_cost = 0,
      new_failure_rate = initial_failure_rate,
      new_rpn = new_rpn_data
    ))
  }
  
  # Calculate reduction needed based on target
  reduction_factor <- target_failure_rate / initial_failure_rate
  
  new_rpn_data <- component_data
  
  for (i in 1:nrow(component_data)) {
    comp <- component_data$Component_Short[i]
    
    # Calculate how much to reduce based on current values and target
    severity_reduction <- max(0, floor((component_data$Max_Severity[i] - 2) * (1 - reduction_factor)))
    occurrence_reduction <- max(0, floor((component_data$Max_Occurrence[i] - 1) * (1 - reduction_factor)))
    detection_reduction <- max(0, floor((component_data$Max_Detection[i] - 1) * (1 - reduction_factor)))
    
    # Calculate costs based on reductions
    if (severity_reduction > 0) {
      cost <- 250000 * severity_reduction * (component_data$Max_Severity[i] / 5)
      
      improvements <- rbind(improvements, data.frame(
        Component = comp,
        Type = "Severity",
        From = component_data$Max_Severity[i],
        To = component_data$Max_Severity[i] - severity_reduction,
        Cost = cost
      ))
      
      new_rpn_data$Max_Severity[i] <- new_rpn_data$Max_Severity[i] - severity_reduction
      total_cost <- total_cost + cost
    }
    
    if (occurrence_reduction > 0) {
      cost <- 180000 * occurrence_reduction * (component_data$Max_Occurrence[i] / 5)
      
      improvements <- rbind(improvements, data.frame(
        Component = comp,
        Type = "Occurrence",
        From = component_data$Max_Occurrence[i],
        To = component_data$Max_Occurrence[i] - occurrence_reduction,
        Cost = cost
      ))
      
      new_rpn_data$Max_Occurrence[i] <- new_rpn_data$Max_Occurrence[i] - occurrence_reduction
      total_cost <- total_cost + cost
    }
    
    if (detection_reduction > 0) {
      cost <- 120000 * detection_reduction * (component_data$Max_Detection[i] / 5)
      
      improvements <- rbind(improvements, data.frame(
        Component = comp,
        Type = "Detection",
        From = component_data$Max_Detection[i],
        To = component_data$Max_Detection[i] - detection_reduction,
        Cost = cost
      ))
      
      new_rpn_data$Max_Detection[i] <- new_rpn_data$Max_Detection[i] - detection_reduction
      total_cost <- total_cost + cost
    }
  }
  
  # Recalculate RPN and RPN reduction
  new_rpn_data$New_RPN <- new_rpn_data$Max_Severity * new_rpn_data$Max_Occurrence * new_rpn_data$Max_Detection
  new_rpn_data$RPN_Reduction <- new_rpn_data$Total_RPN - new_rpn_data$New_RPN
  
  return(list(
    improvements = improvements,
    total_cost = total_cost,
    new_failure_rate = target_failure_rate,
    new_rpn = new_rpn_data
  ))
}

